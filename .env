# ---------------------------------------------------
# Environment Variables - DO NOT commit real secrets
# Copy this file and change values for your machine
# ---------------------------------------------------

# Flask
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=quizuser
DB_PASSWORD=quizpassword
DB_NAME=quiz_app_db

# Quiz Settings
QUESTIONS_PER_QUIZ=10
PASS_PERCENTAGE=50
